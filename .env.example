# Neon Postgres. Vercel sets this for you when you attach the integration.
DATABASE_URL=postgres://habits:habits@localhost:5433/habits

# Web push. Generate once with `npm run keys:vapid` and never rotate —
# rotating invalidates both subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ishaangpta@g.ucla.edu

# Push subscriptions are bound to this origin; changing it breaks them once.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel sends this as a bearer token on the daily cron. Without it, /api/cron
# is publicly triggerable (worst case: an early 8pm summary).
CRON_SECRET=
